{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/assets/*",
      "/*.{css,js,png,jpg,jpeg,gif,svg,ico,woff,woff2,json}"
    ]
  },
  "auth": {
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "externalid": {
          "registration": {
            "clientIdSettingName": "EXTERNAL_ID_KR_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "EXTERNAL_ID_KR_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://678ac1cf-499f-47b9-8aac-d049a7d42195.ciamlogin.com/678ac1cf-499f-47b9-8aac-d049a7d42195/v2.0/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
            "scopes": ["openid", "email"]
          }
        }
      }
    }
  }
}
